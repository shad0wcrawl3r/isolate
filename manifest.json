{
  "manifest_version": 2,
  "name": "Isolate",
  "version": "1.4.0",
  "description": "Open links in a fresh, throwaway Firefox container per tab and suppress Google sign-in prompts.",
  "permissions": [
    "browsingData",
    "contextMenus",
    "contextualIdentities",
    "cookies",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "Reopen this page in an isolated tab"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Alt+I"
      },
      "description": "Reopen this page in an isolated tab"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "isolate@shadowcrawler",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
