{
  "manifest_version": 2,
  "name": "Isolate",
  "version": "1.5.0",
  "description": "Open links in a fresh, throwaway Firefox container per tab and suppress Google sign-in prompts.",
  "homepage_url": "https://github.com/shad0wcrawl3r/isolate",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "browsingData",
    "contextMenus",
    "contextualIdentities",
    "cookies",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Reopen this page in an isolated tab"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Alt+I"
      },
      "description": "Reopen this page in an isolated tab"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "isolate@shadowcrawler",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
